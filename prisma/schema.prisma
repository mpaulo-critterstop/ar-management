generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(COLLECTIONS)
  office    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     CollectionNote[]
  @@map("users")
}

enum Role {
  ADMIN
  COLLECTIONS
  MANAGER
  ACCOUNTING
  LEADERSHIP
  TECHNICIAN
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String?
  phone        String?
  contact      String?
  billingAddr  String?
  serviceAddr  String?
  lat          Float?
  lng          Float?
  geocodedAt   DateTime?
  status       CustomerStatus @default(ACTIVE)
  rep          String?
  terms        String         @default("Net 30")
  notes        String?
  office       String?
  serviceType  String?
  autoReminder Boolean        @default(true)
  externalId   String?
  externalSource String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoices        Invoice[]
  leads           Lead[]
  dispatchJobs    DispatchJob[]
  collectionNotes CollectionNote[]
  paymentPlans PaymentPlan[]
  @@unique([externalId, office])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  COLLECTIONS
}

model Invoice {
  id             String        @id
  customerId     String
  date           DateTime
  due            DateTime?
  amount         Decimal       @db.Decimal(12, 2)
  paid           Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(CURRENT)
  description    String?
  branch         String?
  serviceType    String?
  serviceId      Int?
  office         String?
  externalId     String?
  externalSource String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  arFollowupSent   Boolean   @default(false)
  arFollowupSentAt DateTime?
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  lead            Lead?     @relation("LeadInvoice")
  upsellLead      Lead?     @relation("LeadUpsellInvoice")
  dispatchJob     DispatchJob?
  notes          CollectionNote[]
  plan           PaymentPlan?
  @@index([customerId])
  @@index([status])
  @@index([due])
  @@map("invoices")
}

enum InvoiceStatus {
  CURRENT
  OVERDUE
  COLLECTIONS
  PAYMENT_PLAN
  DISPUTED
  PAID
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String
  date           DateTime
  amount         Decimal  @db.Decimal(12, 2)
  method         String
  reference      String?
  note           String?
  externalId     String?
  externalSource String?
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
  @@map("payments")
}

model CollectionNote {
  id             String           @id @default(cuid())
  customerId     String
  invoiceId      String?
  userId         String?
  date           DateTime         @default(now())
  text           String
  status         CollectionStatus @default(NO_CONTACT)
  followUpDate   DateTime?
  promisedDate   DateTime?
  promisedAmount Decimal?         @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([customerId])
  @@map("collection_notes")
}

enum CollectionStatus {
  NO_CONTACT
  LEFT_VOICEMAIL
  SPOKE
  PAYMENT_PROMISED
  PAYMENT_PLAN
  DISPUTED
  ESCALATED
  LEGAL
}

model PaymentPlan {
  id           String       @id @default(cuid())
  customerId   String
  invoiceId    String       @unique
  totalAmount  Decimal      @db.Decimal(12, 2)
  amountPaid   Decimal      @default(0) @db.Decimal(12, 2)
  status       PlanStatus   @default(ACTIVE)
  rep          String?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments Installment[]
  @@map("payment_plans")
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Installment {
  id        String      @id @default(cuid())
  planId    String
  dueDate   DateTime
  amount    Decimal     @db.Decimal(12, 2)
  paid      Boolean     @default(false)
  paidDate  DateTime?
  method    String?
  createdAt DateTime    @default(now())
  plan      PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@map("installments")
}

model SyncLog {
  id               String    @id @default(cuid())
  source           String
  status           String
  mode             String
  customersCreated Int       @default(0)
  customersUpdated Int       @default(0)
  invoicesCreated  Int       @default(0)
  invoicesUpdated  Int       @default(0)
  paymentsCreated  Int       @default(0)
  errorCount       Int       @default(0)
  errors           String?
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  @@map("sync_logs")
}
model Lead {
  id              String   @id @default(cuid())
  office          String
  externalId      String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  pmId            String?
  pmName          String?
  inspectionDate  DateTime?
  status          String   @default("PENDING")
  invoiceId       String?  @unique
  invoice         Invoice? @relation("LeadInvoice", fields: [invoiceId], references: [id])
  amount          Float?
  upsellAmount    Float?
  upsellDate      DateTime?
  upsellInvoiceId String?   @unique
  upsellInvoice   Invoice?  @relation("LeadUpsellInvoice", fields: [upsellInvoiceId], references: [id])
  followUpSent    Boolean   @default(false)
  followUpSentAt  DateTime?
  wonSent         Boolean   @default(false)
  wonSentAt       DateTime?
  groupId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CsrEmployee {
  id            String    @id @default(cuid())
  frEmployeeId  String    @unique
  name          String
  active        Boolean   @default(true)
  isCsr         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  csrLeads      CsrLead[]
  @@map("csr_employees")
}

model CsrLead {
  id              String       @id @default(cuid())
  leadId          String
  csrEmployeeId   String?
  csrEmployee     CsrEmployee? @relation(fields: [csrEmployeeId], references: [id])
  frEmployeeId    String
  csrName         String?
  points          Float
  role            String
  groupId         String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([leadId, role])
  @@index([frEmployeeId])
  @@index([groupId])
  @@map("csr_leads")
}


model DispatchJob {
  id              String    @id @default(cuid())
  office          String
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  invoiceId       String?   @unique
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  pmName          String?
  
  // What work is included (from invoice line items)
  hasTrapping     Boolean   @default(false)
  hasFAR          Boolean   @default(false)
  hasExclusion    Boolean   @default(true)
  
  // Stage tracking
  exclusionDone   Boolean   @default(false)
  exclusionDate   DateTime?
  trapCheckCount  Int       @default(0)
  trapsDone Boolean @default(false)
  lastTrapCheck   DateTime?
  farDone         Boolean   @default(false)
  farDate         DateTime?
  closedOut       Boolean   @default(false)
  closedOutDate   DateTime?
  
  // Notes
  notes           String?
  
  status          String    @default("ACTIVE") // ACTIVE, CLOSED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PM {
  id        String   @id @default(cuid())
  name      String
  office    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, office])
}

model Technician {
  id            String    @id @default(cuid())
  techId        String    @unique
  name          String
  team          TechTeam
  office        String
  hrDays        Int       @default(8)
  startTime     String    @default("8:00 AM")
  siteLeader    String?
  crewLeader    String?
  hireDate      DateTime?
  termDate      DateTime?
  status        TechStatus @default(ACTIVE)
  notes         String?
  frEmployeeId  Int?
  email         String?  @unique
  bouncieDevice BouncieDevice?
  techWeeks     TechWeek[]
  reviews       TechReview[]
  manualAdjs    ManualAdj[]
  attendance    TechDayAttendance[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("technicians")
}

enum TechTeam {
  WP
  PMP
  IP
}

enum TechStatus {
  ACTIVE
  INACTIVE
}

model BouncieDevice {
  id           String     @id @default(cuid())
  technicianId String     @unique
  bouncieName  String
  deviceId     String?
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@map("bouncie_devices")
}

model TechWeek {
  id              String     @id @default(cuid())
  technicianId    String
  techId          String
  weekEnd         DateTime
  office          String
  team            TechTeam
  siteLeader      String?
  crewLeader      String?

  // Scores (0.0 – 1.1)
  totalScore      Float?
  wpScore         Float?
  pmpScore        Float?
  ipScore         Float?
  manualAdj       Float?     @default(0)

  // WP metrics
  closeOutPct     Float?
  callbackRate    Float?
  coJobs          Int?
  callbackJobs    Int?

  // PMP metrics
  revenueEfficiency Float?
  reseviceRate    Float?
  completionPct   Float?
  productionValue Float?

  // Shared metrics
  drivingScore    Float?
  reliabilityScore Float?
  reviewCount     Int?       @default(0)

  // Driving override (vehicular incident)
  drivingOverride     Boolean?   @default(false)
  drivingOverrideNote String?

  // Raw driving inputs
  maxSpeed        Float?
  safetyAlertsPer1k Float?
  idleRatio       Float?

  // Raw reliability inputs
  minutesLate     Float?
  utilization     Float?

  technician      Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([techId, weekEnd])
  @@index([weekEnd])
  @@index([technicianId])
  @@map("tech_weeks")
}

// One row per tech per route day — stores raw FR route data permanently
// Replaces: AppSetting fp_30da_* blobs, week endpoint re-fetches, run endpoint route count re-fetches
model TechRoute {
  id             String   @id @default(cuid())
  techId         String
  frRouteId      String                         // FR routeID
  date           DateTime                       // route date (day)
  weekEnd        DateTime                       // Friday of the week
  office         String
  completed      Int      @default(0)
  pending        Int      @default(0)
  noShow         Int      @default(0)
  productionValue Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([techId, frRouteId])
  @@index([techId, weekEnd])
  @@index([weekEnd])
  @@index([date])
  @@map("tech_routes")
}

// One row per scheduled customer per tech per day — stores lat/lng for reliability geofencing
// Replaces: AppSetting rc_customers_* blobs consumed by reliability cron
model TechRouteCustomer {
  id              String   @id @default(cuid())
  techId          String
  frAppointmentId String
  customerId      String
  date            DateTime
  weekEnd         DateTime
  office          String
  lat             Float
  lng             Float
  createdAt       DateTime @default(now())

  @@unique([techId, frAppointmentId])
  @@index([techId, date])
  @@index([weekEnd])
  @@map("tech_route_customers")
}

// One row per tech per workday — stores reliability raw inputs permanently
// Replaces: reliability cron only saving week-level aggregates, losing per-day detail
model TechDayReliability {
  id          String    @id @default(cuid())
  techId      String
  date        DateTime
  weekEnd     DateTime
  office      String
  minutesLate Float?
  utilization Float?
  hrsWorked   Float?
  startOfDay  DateTime?
  endOfDay    DateTime?
  scheduledHrs Int?
  source      String?   @default("bouncie") // 'bouncie' | 'fr_fallback'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([techId, date])
  @@index([techId, weekEnd])
  @@index([weekEnd])
  @@map("tech_day_reliability")
}

// Rolling 90-day window of completed PMP appointments — for reservice rate attribution.
// Populated weekly by /api/field-performance/pmpAppointments (fetches new week, prunes >90d).
// Reservice calc reads the trailing 90 days from here instead of re-fetching from FR.
model PmpAppointment {
  id              String   @id @default(cuid())
  frAppointmentId String   @unique   // FR appointment ID
  office          String
  date            DateTime
  serviceTypeId   String              // FR type / serviceTypeID
  isReservice     Boolean             // type ∈ office reserviceTypeIds
  status          String              // FR status ('1' = completed)
  customerId      String
  frEmployeeId    Int?                // servicedBy / employeeID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([office, date])
  @@index([customerId, date])
  @@map("pmp_appointments")
}

model TechReview {
  id           String     @id @default(cuid())
  technicianId String
  techId       String
  reviewDate   DateTime
  weekEnd      DateTime
  gbpLocation  String?
  reviewText   String?
  customerName String?
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@index([techId, reviewDate])
  @@map("tech_reviews")
}

model ManualAdj {
  id              String     @id @default(cuid())
  technicianId    String
  techId          String
  weekEnd         DateTime
  totalPoints     Float      @default(0)
  leadershipPts   Float?     @default(0)
  leadershipNote  String?
  frPts           Float?     @default(0)
  frNote          String?
  reviewsPts      Float?     @default(0)
  reviewsNote     String?
  enteredBy       String?
  technician      Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  @@index([techId, weekEnd])
  @@map("manual_adjs")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("app_settings")
}

model TechDayAttendance {
  id              String     @id @default(cuid())
  technicianId    String
  techId          String
  date            DateTime
  weekEnd         DateTime
  office          String
  team            TechTeam
  routeStartTime  String?
  scheduledHrs    Int        @default(8)
  startTime       DateTime?
  finishTime      DateTime?
  minutesLate     Float?
  hrsWorked       Float?
  status          String?    @default("WORKED") // WORKED, OFF, CALL_OUT
  manualOverride  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  technician      Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  @@unique([techId, date])
  @@index([weekEnd])
  @@index([techId])
  @@map("tech_day_attendance")
}

model TcAppointment {
  id              String    @id @default(cuid())
  frAppointmentId String    @unique  // FieldRoutes appointment ID
  date            DateTime  // appointment date
  weekEnd         DateTime  // Friday of the week
  customerId      String?   // FR customer ID
  customerName    String?
  jobTitle        String?   // appointment type name
  serviceTypeId   Int?
  techId          String?
  techName        String?
  office          String?

  // CO logic
  isCoJob         Boolean?  @default(false)   // Col J
  apptStatus      String?   @default("completed") // 'completed' or 'pending'

  // Populated as future appointments come in (updated over time)
  futureNonCbVisits Int?    // Col K
  nextVisitDays     Int?    // Col L

  // Set at time of appointment sync
  closedOut       Boolean?  // Col M — has close-out note in tech/office notes
  wk1CloseOut     Boolean?  // Col N — closed out within 1 week
  wk2CloseOut     Boolean?  // Col O — closed out within 2 weeks
  cb60Day         Boolean?  // Col P — callback within 60 days
  futureCbs       Int?      // Col Q — future CB appointments for this customer

  // Bouncie
  timeAtJobMins   Float?    // Col R — time within customer geofence

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([weekEnd])
  @@index([techId])
  @@index([date])
  @@index([customerId])
  @@map("tc_appointments")
}

model BouncieTripEvent {
  id            String   @id @default(cuid())
  transactionId String
  imei          String
  timestamp     DateTime
  speed         Float
  lat           Float
  lng           Float
  createdAt     DateTime @default(now())

  @@index([imei, timestamp])
  @@index([transactionId])
  @@map("bouncie_trip_events")
}
