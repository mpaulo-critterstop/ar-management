generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(COLLECTIONS)
  office    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     CollectionNote[]
  @@map("users")
}

enum Role {
  ADMIN
  COLLECTIONS
  MANAGER
  ACCOUNTING
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String?
  phone        String?
  contact      String?
  billingAddr  String?
  serviceAddr  String?
  status       CustomerStatus @default(ACTIVE)
  rep          String?
  terms        String         @default("Net 30")
  notes        String?
  office       String?
  serviceType  String?
  autoReminder Boolean        @default(true)
  externalId   String?
  externalSource String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoices        Invoice[]
  leads           Lead[]
  dispatchJobs    DispatchJob[]
  collectionNotes CollectionNote[]
  paymentPlans PaymentPlan[]
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  COLLECTIONS
}

model Invoice {
  id             String        @id
  customerId     String
  date           DateTime
  due            DateTime?
  amount         Decimal       @db.Decimal(12, 2)
  paid           Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(CURRENT)
  description    String?
  branch         String?
  serviceType    String?
  office         String?
  externalId     String?
  externalSource String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  lead            Lead?
  dispatchJob     DispatchJob?
  notes          CollectionNote[]
  plan           PaymentPlan?
  @@index([customerId])
  @@index([status])
  @@index([due])
  @@map("invoices")
}

enum InvoiceStatus {
  CURRENT
  OVERDUE
  COLLECTIONS
  PAYMENT_PLAN
  DISPUTED
  PAID
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String
  date           DateTime
  amount         Decimal  @db.Decimal(12, 2)
  method         String
  reference      String?
  note           String?
  externalId     String?
  externalSource String?
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
  @@map("payments")
}

model CollectionNote {
  id             String           @id @default(cuid())
  customerId     String
  invoiceId      String?
  userId         String?
  date           DateTime         @default(now())
  text           String
  status         CollectionStatus @default(NO_CONTACT)
  followUpDate   DateTime?
  promisedDate   DateTime?
  promisedAmount Decimal?         @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([customerId])
  @@map("collection_notes")
}

enum CollectionStatus {
  NO_CONTACT
  LEFT_VOICEMAIL
  SPOKE
  PAYMENT_PROMISED
  PAYMENT_PLAN
  DISPUTED
  ESCALATED
  LEGAL
}

model PaymentPlan {
  id           String       @id @default(cuid())
  customerId   String
  invoiceId    String       @unique
  totalAmount  Decimal      @db.Decimal(12, 2)
  amountPaid   Decimal      @default(0) @db.Decimal(12, 2)
  status       PlanStatus   @default(ACTIVE)
  rep          String?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments Installment[]
  @@map("payment_plans")
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Installment {
  id        String      @id @default(cuid())
  planId    String
  dueDate   DateTime
  amount    Decimal     @db.Decimal(12, 2)
  paid      Boolean     @default(false)
  paidDate  DateTime?
  method    String?
  createdAt DateTime    @default(now())
  plan      PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@map("installments")
}

model SyncLog {
  id               String    @id @default(cuid())
  source           String
  status           String
  mode             String
  customersCreated Int       @default(0)
  customersUpdated Int       @default(0)
  invoicesCreated  Int       @default(0)
  invoicesUpdated  Int       @default(0)
  paymentsCreated  Int       @default(0)
  errorCount       Int       @default(0)
  errors           String?
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  @@map("sync_logs")
}
model Lead {
  id              String   @id @default(cuid())
  office          String
  externalId      String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  pmId            String?
  pmName          String?
  inspectionDate  DateTime?
  status          String   @default("PENDING")
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  amount          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DispatchJob {
  id              String   @id @default(cuid())
  office          String
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  pmName          String?
  hasTrapping     Boolean  @default(false)
  hasFAR          Boolean  @default(false)
  exclusionDone   Boolean  @default(false)
  trappingDone    Boolean  @default(false)
  farDone         Boolean  @default(false)
  closeOutForm    String?
  closedOut       Boolean  @default(false)
  closedOutDate   DateTime?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
